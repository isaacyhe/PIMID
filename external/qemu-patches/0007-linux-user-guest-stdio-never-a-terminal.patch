+/* PIMID patch 0007: the guest's standard input, output and error (fds 0-2) */
+static inline bool guest_stdio_notty_fd(int fd)
+{
+    return qemu_stdio_notty && fd >= 0 && fd <= 2;
+}
+
+/*
+ * PIMID patch 0007: a standard stream reports itself as a pipe, whatever the host's is: owned by the
+ * process's own user and group, with device, inode and times 0. The host stream's owner, device, inode
+ * and times reached the guest's memory through the stat buffer (a terminal belongs to group tty).
+ */
+static inline void guest_stdio_notty_stat(struct stat *st)
+{
+    st->st_mode = S_IFIFO | 0600;
+    st->st_nlink = 1;
+    st->st_rdev = 0;
+    st->st_size = 0;
+    st->st_blocks = 0;
+    st->st_dev = 0;
+    st->st_ino = 0;
+    st->st_uid = getuid();
+    st->st_gid = getgid();
+    st->st_atim.tv_sec = 0;
+    st->st_atim.tv_nsec = 0;
+    st->st_mtim.tv_sec = 0;
+    st->st_mtim.tv_nsec = 0;
+    st->st_ctim.tv_sec = 0;
+    st->st_ctim.tv_nsec = 0;
+}
 
