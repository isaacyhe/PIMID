+/* PIMID patch 0008: the owner a stat result reports: the host user's own ids become the guest's */
+static inline uid_t guest_owner_uid(uid_t u)
+{
+    if (qemu_guest_ids_set && (u == getuid() || u == geteuid())) {
+        return qemu_guest_uid;
+    }
+    return u;
+}
+
+/*
+ * PIMID patch 0008: the permissions a stat result reports for a regular file or directory the host user owns:
+ * 0755 for a directory or a file its owner can execute, 0644 otherwise, whatever the host's group and other bits
+ * (they followed the umask the file was installed with, and the guest's dynamic linker keeps them in memory).
+ */
+static inline unsigned int guest_mode(unsigned int mode, uid_t owner)
+{
+    if (!qemu_guest_ids_set || !(owner == getuid() || owner == geteuid()) ||
+        !(S_ISREG(mode) || S_ISDIR(mode))) {
+        return mode;
+    }
+    return (mode & S_IFMT) | ((S_ISDIR(mode) || (mode & S_IXUSR)) ? 0755 : 0644);
+}
+
+static inline gid_t guest_owner_gid(gid_t g)
+{
+    static int ngroups = -1;
+    static gid_t groups[NGROUPS_MAX];
+    int i;
+
+    if (!qemu_guest_ids_set) {
+        return g;
+    }
+    if (g == getgid() || g == getegid()) {
+        return qemu_guest_gid;
+    }
+    if (ngroups < 0) {
+        ngroups = getgroups(NGROUPS_MAX, groups);
+    }
+    for (i = 0; i < ngroups; i++) {
+        if (groups[i] == g) {
+            return qemu_guest_gid;
+        }
+    }
+    return g;
+}
 
