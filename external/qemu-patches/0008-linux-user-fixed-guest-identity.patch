+static void handle_arg_guest_ids(const char *arg)
+{
+    /* PIMID patch 0008: the guest's fixed user and group ids, "U:G" */
+    char *end = NULL;
+    unsigned long u = strtoul(arg, &end, 10), g;
+    if (!end || *end != ':') {
+        fprintf(stderr, "qemu: -guest-ids needs UID:GID, not '%s'\n", arg);
+        exit(EXIT_FAILURE);
+    }
+    g = strtoul(end + 1, &end, 10);
+    if (!end || *end) {
+        fprintf(stderr, "qemu: -guest-ids needs UID:GID, not '%s'\n", arg);
+        exit(EXIT_FAILURE);
+    }
+    qemu_guest_ids_set = true;
+    qemu_guest_uid = u;
+    qemu_guest_gid = g;
+}
+
+static void handle_arg_rlimit_stack(const char *arg)
+{
+    /* PIMID patch 0008: the stack limit the guest reads, in bytes */
+    char *end = NULL;
+    unsigned long long v = strtoull(arg, &end, 0);
+    if (!end || *end) {
+        fprintf(stderr, "qemu: -rlimit-stack needs a byte count, not '%s'\n", arg);
+        exit(EXIT_FAILURE);
+    }
+    qemu_rlimit_stack = v;
+}
+
+static void handle_arg_execfn(const char *arg)
+{
+    /* PIMID patch 0008: the program path the guest's auxiliary vector carries */
+    qemu_execfn = strdup(arg);
+}
+
 static void handle_arg_gdb(const char *arg)
 {
     gdbstub = g_strdup(arg);
