 {
     gdbstub = g_strdup(arg);
@@ -549,6 +561,8 @@ static const struct qemu_argument arg_table[] = {
      "number",     "guest process and thread IDs are this base plus 4194304 plus their order of first sight"},
     {"tsc-step",   "QEMU_TSC_STEP",    true,  handle_arg_tsc_step,
      "number",     "the guest's time stamp counter advances by this step on every read (0: the host's)"},
+    {"st-blksize", "QEMU_ST_BLKSIZE",  true,  handle_arg_st_blksize,
+     "number",     "the block size the guest's stat calls report (0: the host file system's)"},
