+/*
+ * PIMID patch 0003: fixed-width guest process and thread IDs (-tid-base N).
+ * With N > 0 every process, thread, process-group and session ID the guest
+ * sees is the host's ID plus N, and every such ID the guest passes back is
+ * the guest's minus N. With N = 10000000 and Linux's pid_max at most 4194304,
+ * every guest-visible ID has eight decimal digits, so guest code that formats
+ * its thread ID (glibc 2.39's start_thread names each thread's stack with
+ * "%u" of its TID) does the same work on every host. N = 0: unchanged.
+ */
+extern abi_long qemu_pid_base;
+static inline abi_long pid_h2g(abi_long h)
+{
+    return (qemu_pid_base && h > 0) ? h + qemu_pid_base : h;
+}
+static inline abi_long pid_g2h(abi_long g)
+{
+    if (qemu_pid_base && g > qemu_pid_base) {
+        return g - qemu_pid_base;
+    }
+    if (qemu_pid_base && g < -qemu_pid_base) {
+        return g + qemu_pid_base;   /* a negated process group */
+    }
+    return g;
+}
+/* "/proc/<id>..." and "/proc/<x>/task/<id>..." with guest IDs, rewritten to host IDs */
+const char *proc_path_g2h(const char *pathname, char *buf, size_t len);
