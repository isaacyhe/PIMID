+        break;
+#endif
+    case TARGET_NR_getpriority:
+    case TARGET_NR_setpriority:       /* (which, who): PRIO_PROCESS 0, PRIO_PGRP 1 */
+        if (which == 0 || which == 1) {
+            *a2 = pid_g2h(*a2);
+        }
+        break;
+#ifdef TARGET_NR_ioprio_get
+    case TARGET_NR_ioprio_get:
+    case TARGET_NR_ioprio_set:        /* (which, who): IOPRIO_WHO_PROCESS 1, IOPRIO_WHO_PGRP 2 */
+        if (which == 1 || which == 2) {
+            *a2 = pid_g2h(*a2);
+        }
+        break;
+#endif
+    default:
+        break;
+    }
