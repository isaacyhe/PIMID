+static const char *proc_id_g2h(const char *q, char **out, char *end)
+{
+    /* copies one path component; a component of decimal digits is a guest ID, translated */
+    char comp[64];
+    size_t n = 0;
+    bool digits = true;
+    while (*q && *q != '/' && n < sizeof(comp) - 1) {
+        digits = digits && *q >= '0' && *q <= '9';
+        comp[n++] = *q++;
+    }
+    comp[n] = 0;
+    if (n && digits) {
+        *out += snprintf(*out, end - *out, "%lld", (long long)pid_g2h(strtoll(comp, NULL, 10)));
+    } else {
+        *out += snprintf(*out, end - *out, "%s", comp);
+    }
+    return q;
+}
+
+const char *proc_path_g2h(const char *pathname, char *buf, size_t len)
+{
+    const char *q = pathname;
+    char *o = buf, *end = buf + len;
+    if (!qemu_pid_base || !pathname || strncmp(pathname, "/proc/", 6) != 0 ||
+        strlen(pathname) + 32 >= len) {
+        return pathname;
+    }
+    o += snprintf(o, end - o, "/proc/");
+    q += 6;
+    q = proc_id_g2h(q, &o, end);
+    if (!strncmp(q, "/task/", 6)) {
+        o += snprintf(o, end - o, "/task/");
+        q += 6;
+        q = proc_id_g2h(q, &o, end);
+    }
+    snprintf(o, end - o, "%s", q);
+    return buf;
+}
