# This sample PCRAM cell configuration is generated from the following paper:
# Architecting Phase Change Memory as a Scalable DRAM Alternative
# Proceedings of International symposium on Computer architecture, 2009

-MemCellType: PCRAM

-ProcessNode: 90

-CellArea (F^2): 9
-CellAspectRatio: 1

-ResistanceOn (ohm): 1000
-ResistanceOff (ohm): 1000000

-ReadMode: voltage
-ReadCurrent (uA): 40
-ReadEnergy (pJ): 2
# PIMID (1.12.243): Lee et al., ISCA 2009, Section 2.4: a cell read takes 48 ns (Bedeschi et al.), bitline precharge and
# current sensing included, at 40 uA and 1.0 V; the 2 pJ ReadEnergy above is that read (40 uW for 48 ns).
-CellReadLatency (ns): 48

-ResetMode: current
-ResetCurrent (uA): 300
-ResetPulse (ns): 40
# PIMID (1.12.93): Lee et al., ISCA 2009, Table 1 ('this work'): RESET 300 uA, 1.6 V, 480 uW for 40 ns = 19.2 pJ
-ResetEnergy (pJ): 19.2

-SetMode: current
-SetCurrent (uA): 150
-SetPulse (ns): 150
# PIMID (1.12.93): Lee et al., ISCA 2009, Table 1 ('this work'): SET 150 uA, 1.2 V, 90 uW for 150 ns = 13.5 pJ
-SetEnergy (pJ): 13.5

-AccessType: CMOS
-VoltageDropAccessDevice (V): 0.3
-AccessCMOSWidth (F): 2