# Build directories
build/
*/build/
*/build-*/
cmake-build-*/

# Compiled files
*.o
*.so
*.a
*.out
*.exe
*.app

# Log files
*.log
*.log.*

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
**/build/Makefile
**/cmake_build/Makefile

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Intel PIN (large binary, download separately)
pin-*/
pin-external-*/
external/pin-*

